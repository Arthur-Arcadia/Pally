APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
GUILD_ID=1542404404680982550
# Voice membership for Portrait (and future Random Picker)
GAME_VOICE_CHANNEL_ID=1542404405301878860
# Existing text channel for the panel, portrait prompts and results
SOCIAL_TEXT_CHANNEL_ID=1542404405301878856
# Persist fair rotation and interrupted-round recovery (mount /app/data in Docker)
STATE_DIR=./data
# Channel containing the persistent control panel
PANEL_CHANNEL_ID=<YOUR_PANEL_CHANNEL_ID>
# Optional: use a separate chat channel to keep the panel channel uncluttered
RESULT_CHANNEL_ID=
# Optional: printed by npm run panel; reuse to update the exact same message
PANEL_MESSAGE_ID=
